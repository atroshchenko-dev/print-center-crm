APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=uk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=uk_UA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Defaults to true when APP_ENV=production (config/session.php); set
# explicitly so the flag is a decision, not an accident. false is for
# local http only.
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Production Mail (Office 365) ───────────────
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_USERNAME=print@example.edu
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=print@example.edu
# MAIL_FROM_NAME="Центр поліграфії"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Deploy Webhook ──────────────────────────────
# Required for GitHub webhook auto-deploy (SHA-256 HMAC validation)
# Must match the secret configured in GitHub → Settings → Webhooks
DEPLOY_SECRET=

# Deploy only after CI goes green (GitHub `workflow_run` event, conclusion
# success, branch main). Set to false to fall back to deploying on every push.
# The webhook must be subscribed to "Workflow runs".
DEPLOY_REQUIRE_CI=true
DEPLOY_CI_WORKFLOW=CI

# ─── Personal Data Retention ────────────────────
# How long a signatory's name, email and IP are kept after their approval
# stopped being live. Enforced nightly by `privacy:prune` — see docs/PII.md.
PRIVACY_APPROVAL_RETENTION_DAYS=365

# ─── Telegram Notifications ─────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Second addressee, for the signatory's answers only — the group where the
# electronic requests are watched. Everything else keeps going to
# TELEGRAM_CHAT_ID alone.
#
# Empty means the feature is off and approvals behave exactly as they did
# before it existed. A group id is negative, e.g. -1002233445566.
TELEGRAM_APPROVALS_CHAT_ID=

# ─── Production Overrides ───────────────────────
# APP_ENV=production
# APP_DEBUG=false          ← ОБОВ'ЯЗКОВО false на production!
# APP_URL=https://print.example.com
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=crm_print
# DB_USERNAME=crm_user
# DB_PASSWORD=
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# REDIS_CLIENT=predis
